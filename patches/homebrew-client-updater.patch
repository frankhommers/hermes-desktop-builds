+    verifiedInstalledCommunityVersion('0.17.2.1', '0.17.2.2', { ...stamp, distributionVersion: '0.17.2.3' }, runtime),
+    '0.17.2.3'
+  )
+  assert.throws(() => verifiedInstalledCommunityVersion('0.17.2.1', '0.17.2.2', stamp, runtime))
+  assert.throws(() =>
+    verifiedInstalledCommunityVersion('0.17.2.1', '0.17.2.3', { ...stamp, distributionVersion: '0.17.2.2' }, runtime)
+  )
+  assert.throws(() =>
+    verifiedInstalledCommunityVersion(
+      '0.17.2.1',
+      '0.17.2.2',
+      { ...stamp, distribution: 'somebody-else', distributionVersion: '0.17.2.2' },
+      runtime
+    )
+  )
+})
+
+test('brew resolution accepts only an executable from the fixed macOS locations', () => {
+  assert.equal(pickHomebrewBinary(path => path === '/opt/homebrew/bin/brew'), '/opt/homebrew/bin/brew')
+  assert.equal(pickHomebrewBinary(path => path === '/usr/local/bin/brew'), '/usr/local/bin/brew')
+  assert.equal(pickHomebrewBinary(() => false), null)
+})
+
+test('package update executes fixed argv in order and stops on failure', async () => {
+  const calls: { command: string; args: string[] }[] = []
+  await runHomebrewUpdate('/opt/homebrew/bin/brew', async (command, args) => {
+    calls.push({ command, args })
+    return { code: 0, output: 'ok' }
+  })
+  assert.deepEqual(calls, [
+    { command: '/opt/homebrew/bin/brew', args: ['update'] },
+    { command: '/opt/homebrew/bin/brew', args: ['upgrade', '--cask', COMMUNITY_CASK] }
+  ])
+
+  await assert.rejects(
+    () =>
+      runHomebrewUpdate('/opt/homebrew/bin/brew', async (_command, args) => ({
+        code: args[0] === 'update' ? 1 : 0,
+        output: 'network failed'
+      })),
+    /Homebrew update failed.*network failed/
+  )
+})
