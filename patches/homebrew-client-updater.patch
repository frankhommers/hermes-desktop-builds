+    // The package owner (Homebrew) applies the update; this app only drives it.
+    mechanism: 'external',
+    check: async opts => ({ ...(await check(opts)), mechanism: 'external' }),
+    apply: async (): Promise<UpdaterApplyResultWire> => {
+      const brew = pickHomebrewBinary(candidate => {
+        try {
+          fs.accessSync(candidate, fs.constants.X_OK)
+
+          return true
+        } catch {
+          return false
+        }
+      })
+
+      if (!brew) {
+        return {
+          ok: false,
+          mechanism: 'external',
+          error: 'Homebrew was not found in /opt/homebrew or /usr/local. Reinstall this community build through Homebrew first.',
+          manual: true,
+          command: `brew update && brew upgrade --cask ${config.cask}`
+        }
+      }
+
+      try {
+        emitUpdateProgress({ stage: 'prepare', message: 'Checking the Homebrew tap…', percent: 5 })
+        const status = await check({ force: true })
+
+        if (status.error) {
+          throw new Error(status.message || 'Could not check the Homebrew tap.')
+        }
+
+        if (!status.updateAvailable) {
+          return { ok: false, mechanism: 'external', error: 'No newer Hermes Desktop package is available in the Homebrew tap.' }
+        }
+
+        await runHomebrewUpdate(brew, runCommunityHomebrewCommand, step => {
+          emitUpdateProgress(
+            step === 'update'
+              ? { stage: 'fetch', message: 'Refreshing the Homebrew tap…', percent: 20 }
+              : { stage: 'install', message: 'Installing the Hermes Desktop update…', percent: 65 }
+          )
+        })
+
+        // The running process carries its baked stamp; only the on-disk
+        // sidecar at the running resources path proves Homebrew replaced it.
+        const installedVersion = verifiedInstalledCommunityVersion(
+          config.currentVersion,
+          status.targetVersion,
+          readInstalledCommunityStamp(process.resourcesPath),
+          { isPackaged: IS_PACKAGED, platform: process.platform }
+        )
+
+        rememberLog(
+          `[updates] Homebrew replaced Hermes Desktop ${config.currentVersion} with ${installedVersion} at the running app path`
+        )
+        emitUpdateProgress({ stage: 'restart', message: 'Update installed. Restarting Hermes Desktop…', percent: 100 })
+        relaunchApp(relauncher, {})
+        isQuittingForHandoff = true
+        setTimeout(() => void exitAfterBackendShutdown(0), 250)
+
+        return { ok: true, mechanism: 'external', handedOff: true, guiUpdated: true, targetSha: status.targetSha }
+      } catch (error) {
+        const message = error?.message || String(error)
+        emitUpdateProgress({ stage: 'error', message, error: message, percent: null })
+
+        return { ok: false, mechanism: 'external', error: message }
+      }
+    }
