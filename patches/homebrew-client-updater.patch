index 0000000000000000000000000000000000000000..169cdeb74737ec1349139e20c95b955efe6fcb42
--- /dev/null
+++ b/apps/desktop/electron/community-homebrew-update.ts
@@ -0,0 +1,391 @@
+import fs from 'node:fs'
+import type { Agent } from 'node:http'
+import https from 'node:https'
+import path from 'node:path'
+
+import { updateCheckAgent } from './update-api-proxy'
+
+export const COMMUNITY_DISTRIBUTION = 'frankhommers-homebrew'
+export const COMMUNITY_CASK = 'frankhommers/tap/hermes-desktop'
+export const COMMUNITY_CASK_CONTENTS_API =
+  'https://api.github.com/repos/frankhommers/homebrew-tap/contents/casks/hermes-desktop.rb?ref=main'
+
+const VERSION_SEGMENT_PATTERN = /^(?:0|[1-9]\d{0,8})$/
+const MAX_CASK_BYTES = 64 * 1024
+const HOMEBREW_BINARIES = ['/opt/homebrew/bin/brew', '/usr/local/bin/brew'] as const
+
+/**
+ * Upstream owns the stamp's `distribution` ('desktop-app' | 'docker' | 'nix');
+ * the community identity rides in its own key so upstream's Distribution label
+ * and uninstall classification keep their meaning.
+ */
+interface InstallStampLike {
+  distribution?: unknown
+  communityDistribution?: unknown
+  distributionVersion?: unknown
+}
+
+export interface CommunityHomebrewConfig {
+  currentVersion: string
+  cask: typeof COMMUNITY_CASK
+  contentsApi: typeof COMMUNITY_CASK_CONTENTS_API
+}
+
+export interface CommunityHomebrewRuntime {
+  isPackaged: boolean
+  platform: NodeJS.Platform | string
+}
+
+export function isDottedVersion(value: unknown): value is string {
+  if (typeof value !== 'string') {
+    return false
+  }
+
+  const segments = value.split('.')
+
+  return (
+    segments.length >= 3 && segments.length <= 4 && segments.every(segment => VERSION_SEGMENT_PATTERN.test(segment))
+  )
+}
+
+/** Enable this updater only for a stamped, packaged build from Frank's macOS tap. */
+export function communityHomebrewConfig(
+  stamp: InstallStampLike | null | undefined,
+  runtime: CommunityHomebrewRuntime
+): CommunityHomebrewConfig | null {
+  if (
+    !runtime.isPackaged ||
+    runtime.platform !== 'darwin' ||
+    stamp?.communityDistribution !== COMMUNITY_DISTRIBUTION ||
+    !isDottedVersion(stamp.distributionVersion)
+  ) {
+    return null
+  }
+
+  return {
+    currentVersion: stamp.distributionVersion,
+    cask: COMMUNITY_CASK,
+    contentsApi: COMMUNITY_CASK_CONTENTS_API
+  }
+}
+
+export function compareDottedVersions(left: string, right: string): -1 | 0 | 1 {
+  if (!isDottedVersion(left) || !isDottedVersion(right)) {
+    throw new Error('Cannot compare a malformed desktop distribution version')
+  }
+
+  const a = left.split('.').map(Number)
+  const b = right.split('.').map(Number)
+  const length = Math.max(a.length, b.length)
+
+  for (let index = 0; index < length; index += 1) {
+    const difference = (a[index] ?? 0) - (b[index] ?? 0)
+
+    if (difference < 0) {
+      return -1
+    }
+
+    if (difference > 0) {
+      return 1
+    }
+  }
+
+  return 0
+}
+
+/** Parse GitHub's Contents API response without ever treating tap text as executable data. */
+export function parseCaskContentsResponse(payload: unknown): string {
+  if (!payload || typeof payload !== 'object') {
+    throw new Error('Homebrew tap response is not an object')
+  }
+
+  const response = payload as { content?: unknown; encoding?: unknown; size?: unknown; type?: unknown }
+
+  if (
+    response.type !== 'file' ||
+    response.encoding !== 'base64' ||
+    typeof response.content !== 'string' ||
+    typeof response.size !== 'number' ||
+    !Number.isInteger(response.size) ||
+    response.size < 1 ||
+    response.size > MAX_CASK_BYTES
+  ) {
+    throw new Error('Homebrew tap response has an invalid file envelope')
+  }
+
+  const compact = response.content.replace(/\s/g, '')
+
+  if (!compact || compact.length > Math.ceil(MAX_CASK_BYTES / 3) * 4 || !/^[A-Za-z0-9+/]+={0,2}$/.test(compact)) {
+    throw new Error('Homebrew tap response contains malformed base64')
+  }
+
+  const raw = Buffer.from(compact, 'base64')
+
+  if (raw.toString('base64') !== compact || raw.length !== response.size || raw.length > MAX_CASK_BYTES) {
+    throw new Error('Homebrew tap response size or encoding does not match its envelope')
+  }
+
+  let source: string
+
+  try {
+    source = new TextDecoder('utf-8', { fatal: true }).decode(raw)
+  } catch {
+    throw new Error('Homebrew cask source is not valid UTF-8')
+  }
+
+  if (!source || source.includes('\0')) {
+    throw new Error('Homebrew cask source is empty or invalid')
+  }
+
+  const casks = [...source.matchAll(/^\s*cask\s+"([^"]+)"\s+do\s*$/gm)]
+
+  if (casks.length !== 1 || casks[0]?.[1] !== 'hermes-desktop') {
+    throw new Error('Homebrew cask source has an unexpected identity')
+  }
+
+  const versions = [...source.matchAll(/^\s*version\s+"([^"]+)"\s*$/gm)]
+  const version = versions.length === 1 ? versions[0]?.[1] : undefined
+
+  if (!isDottedVersion(version)) {
+    throw new Error('Homebrew cask does not contain exactly one strict numeric version')
+  }
+
+  return version
+}
+
+/** GUI apps do not inherit shell PATH; accept only Homebrew's two standard macOS locations. */
+export function pickHomebrewBinary(isExecutable: (candidate: string) => boolean): string | null {
+  for (const candidate of HOMEBREW_BINARIES) {
+    if (isExecutable(candidate)) {
+      return candidate
+    }
+  }
+
+  return null
+}
+
+export interface HomebrewCommandResult {
+  code: number
+  output: string
+}
+
+const MAX_STAMP_BYTES = 64 * 1024
+
+/**
+ * The running process carries its baked stamp; only the packaged sidecar at the
+ * running resources path shows what Homebrew left on disk. Unreadable, oversized
+ * or non-object content is no proof of replacement.
+ */
+export function readInstalledCommunityStamp(resourcesPath: string, read = fs.readFileSync): InstallStampLike | null {
+  try {
+    const raw = read(path.join(resourcesPath, 'install-stamp.json'))
+
+    if (raw.length > MAX_STAMP_BYTES) {
+      return null
+    }
+
+    const parsed: unknown = JSON.parse(raw.toString('utf8'))
+
+    return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? (parsed as InstallStampLike) : null
+  } catch {
+    return null
+  }
+}
+
+/** Prove Homebrew replaced this running distribution before claiming success or relaunching. */
+export function verifiedInstalledCommunityVersion(
+  beforeVersion: string,
+  targetVersion: string,
+  installedStamp: InstallStampLike | null | undefined,
+  runtime: CommunityHomebrewRuntime
+): string {
+  const installed = communityHomebrewConfig(installedStamp, runtime)
+
+  if (!installed) {
+    throw new Error('Homebrew did not install a valid Hermes Desktop community bundle at the running app path')
+  }
+
+  if (
+    compareDottedVersions(installed.currentVersion, beforeVersion) <= 0 ||
+    compareDottedVersions(installed.currentVersion, targetVersion) < 0
+  ) {
+    throw new Error(
+      `Homebrew finished but the running app path still contains Hermes Desktop ${installed.currentVersion}; expected at least ${targetVersion}`
+    )
+  }
+
+  return installed.currentVersion
+}
+
+export type HomebrewCommandRunner = (command: string, args: string[]) => Promise<HomebrewCommandResult>
+
+// ESC, built at runtime so the pattern carries no literal control character.
+const ANSI_COLOR = new RegExp(`${String.fromCharCode(27)}\\[[0-9;]*m`, 'g')
+
+function failureOutput(value: string): string {
+  const normalized = value.replace(ANSI_COLOR, '').trim()
+
+  return normalized.length > 2_000 ? normalized.slice(-2_000) : normalized
+}
+
+/** Fixed executable + argv only: no shell, no interpolation, and stop at the first failure. */
+export async function runHomebrewUpdate(
+  brew: string,
+  run: HomebrewCommandRunner,
+  onStep?: (step: 'update' | 'upgrade') => void
+): Promise<void> {
+  const steps: Array<{ name: 'update' | 'upgrade'; args: string[] }> = [
+    { name: 'update', args: ['update'] },
+    { name: 'upgrade', args: ['upgrade', '--cask', COMMUNITY_CASK] }
+  ]
+
+  for (const step of steps) {
+    onStep?.(step.name)
+    const result = await run(brew, step.args)
+
+    if (!Number.isInteger(result.code) || result.code !== 0) {
+      const detail = failureOutput(result.output)
+      throw new Error(`Homebrew ${step.name} failed (exit ${result.code})${detail ? `: ${detail}` : ''}`)
+    }
+  }
+}
+
+const MAX_CONTENTS_RESPONSE_BYTES = 256 * 1024
+const CHECK_TIMEOUT_MS = 15_000
+export const COMMUNITY_CHECK_TTL_MS = 24 * 60 * 60 * 1000
+export const COMMUNITY_CHECK_FAILURE_TTL_MS = 60 * 60 * 1000
+
+export interface CommunityHomebrewStatus {
+  supported: true
+  branch: 'homebrew'
+  currentBranch: 'homebrew'
+  currentSha: string
+  currentVersion: string
+  dirty: false
+  hermesRoot: string
+  fetchedAt: number
+  updateAvailable?: boolean
+  behind?: number | null
+  targetSha?: string
+  targetVersion?: string
+  commits?: []
+  error?: 'fetch-failed'
+  message?: string
+}
+
+export type CommunityContentsFetcher = (url: string) => Promise<unknown>
+
+/** One anonymous, bounded GET of the fixed tap contents URL. Redirects are refused. */
+export function fetchCaskContents(
+  url: string,
+  get: typeof https.get = https.get,
+  agent: Agent | undefined = updateCheckAgent(url)
+): Promise<unknown> {
+  if (url !== COMMUNITY_CASK_CONTENTS_API) {
+    return Promise.reject(new Error('Refusing an unexpected Homebrew tap URL'))
+  }
+
+  return new Promise((resolve, reject) => {
+    const request = get(
+      url,
+      {
+        agent,
+        headers: { Accept: 'application/vnd.github+json', 'User-Agent': 'hermes-desktop-update-check' },
+        timeout: CHECK_TIMEOUT_MS
+      },
+      response => {
+        if (response.statusCode !== 200) {
+          response.resume()
+          reject(new Error(`Homebrew tap check failed with HTTP ${response.statusCode ?? 'error'}`))
+
+          return
+        }
+
+        const chunks: Buffer[] = []
+        let size = 0
+        response.on('data', (chunk: Buffer) => {
+          size += chunk.length
+
+          if (size > MAX_CONTENTS_RESPONSE_BYTES) {
+            request.destroy(new Error('Homebrew tap response is too large'))
+
+            return
+          }
+
+          chunks.push(chunk)
+        })
+        response.on('error', reject)
+        response.on('end', () => {
+          try {
+            resolve(JSON.parse(Buffer.concat(chunks).toString('utf8')))
+          } catch {
+            reject(new Error('Homebrew tap response is not JSON'))
+          }
+        })
+      }
+    )
+
+    request.on('timeout', () => request.destroy(new Error('Homebrew tap check timed out')))
+    request.on('error', reject)
+  })
+}
+
+/** Distribution-version-keyed check with the same success/failure TTLs as the old update cache. */
+export class CommunityHomebrewChecker {
+  private cached: CommunityHomebrewStatus | null = null
+
+  constructor(
+    private readonly fetchContents: CommunityContentsFetcher = fetchCaskContents,
+    private readonly now: () => number = Date.now
+  ) {}
+
+  async check(
+    config: CommunityHomebrewConfig,
+    hermesRoot: string,
+    { force = false }: { force?: boolean } = {}
+  ): Promise<CommunityHomebrewStatus> {
+    const now = this.now()
+    const currentSha = `homebrew:${config.currentVersion}`
+    const cached = this.cached
+
+    if (!force && cached && cached.currentSha === currentSha) {
+      const ttl = cached.error ? COMMUNITY_CHECK_FAILURE_TTL_MS : COMMUNITY_CHECK_TTL_MS
+
+      if (now >= cached.fetchedAt && now - cached.fetchedAt < ttl) {
+        return cached
+      }
+    }
+
+    const base = {
+      supported: true as const,
+      branch: 'homebrew' as const,
+      currentBranch: 'homebrew' as const,
+      currentSha,
+      currentVersion: config.currentVersion,
+      dirty: false as const,
+      hermesRoot,
+      fetchedAt: now
+    }
+
+    let status: CommunityHomebrewStatus
+
+    try {
+      const targetVersion = parseCaskContentsResponse(await this.fetchContents(config.contentsApi))
+      const comparison = compareDottedVersions(config.currentVersion, targetVersion)
+      status = {
+        ...base,
+        updateAvailable: comparison < 0,
+        behind: comparison < 0 ? null : 0,
+        targetSha: `homebrew:${targetVersion}`,
+        targetVersion,
+        commits: []
+      }
+    } catch (error) {
+      status = { ...base, error: 'fetch-failed', message: error instanceof Error ? error.message : String(error) }
+    }
+
+    this.cached = status
+
+    return status
+  }
+}
