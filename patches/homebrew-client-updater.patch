+const stamp = {
+  distribution: 'frankhommers-homebrew',
+  distributionVersion: '0.17.2.1'
+}
+
+function caskPayload(source: string, overrides: Record<string, unknown> = {}) {
+  const raw = Buffer.from(source)
+
+  return { encoding: 'base64', type: 'file', size: raw.length, content: raw.toString('base64'), ...overrides }
+}
+
+test('only the packaged Frank Homebrew macOS distribution enables package updates', () => {
+  assert.deepEqual(communityHomebrewConfig(stamp, { isPackaged: true, platform: 'darwin' }), {
+    currentVersion: '0.17.2.1',
+    cask: COMMUNITY_CASK,
+    contentsApi: COMMUNITY_CASK_CONTENTS_API
+  })
+  assert.equal(communityHomebrewConfig(stamp, { isPackaged: false, platform: 'darwin' }), null)
+  assert.equal(communityHomebrewConfig(stamp, { isPackaged: true, platform: 'linux' }), null)
+  assert.equal(
+    communityHomebrewConfig({ ...stamp, distribution: 'somebody-else' }, { isPackaged: true, platform: 'darwin' }),
+    null
+  )
+  assert.equal(
+    communityHomebrewConfig({ ...stamp, distributionVersion: '0.17.2.1; touch /tmp/pwn' }, { isPackaged: true, platform: 'darwin' }),
+    null
+  )
+})
+
+test('the tap payload yields only one strict version from the expected cask', () => {
+  const source = 'cask "hermes-desktop" do\n  version "0.17.2.3"\nend\n'
+  assert.equal(parseCaskContentsResponse(caskPayload(source)), '0.17.2.3')
+  assert.throws(() => parseCaskContentsResponse(caskPayload(source, { content: '@@@' })))
+  assert.throws(() => parseCaskContentsResponse(caskPayload(source, { encoding: 'utf8' })))
+  assert.throws(() => parseCaskContentsResponse(caskPayload(source, { size: Buffer.byteLength(source) - 1 })))
+  assert.throws(() =>
+    parseCaskContentsResponse(caskPayload('cask "somebody-else" do\n  version "0.17.2.3"\nend\n'))
+  )
+  assert.throws(() =>
+    parseCaskContentsResponse(caskPayload('cask "hermes-desktop" do\n  version "0.17.2.3"\n  version "0.17.2.4"\nend\n'))
+  )
+  assert.throws(() =>
+    parseCaskContentsResponse(caskPayload('cask "hermes-desktop" do\n  version "0.17.2.3; rm -rf /"\nend\n'))
+  )
+  assert.throws(() =>
+    parseCaskContentsResponse({
+      encoding: 'base64',
+      type: 'file',
+      size: 2,
+      content: Buffer.from([0xc3, 0x28]).toString('base64')
+    })
+  )
+})
+
+test('numeric dotted comparison is exact and rejects unsafe version shapes', () => {
+  assert.equal(compareDottedVersions('0.17.2', '0.17.2.1'), -1)
+  assert.equal(compareDottedVersions('0.17.2.10', '0.17.2.9'), 1)
+  assert.equal(compareDottedVersions('0.17.2.1', '0.17.2.1'), 0)
+  assert.throws(() => compareDottedVersions('0.17.9007199254740992', '0.17.9007199254740993'))
+  assert.throws(() => compareDottedVersions('0.17.2.1.1', '0.17.2.1'))
+})
+
+test('post-install proof requires the running community bundle to reach the checked target', () => {
+  const runtime = { isPackaged: true, platform: 'darwin' }
+  assert.equal(
+    verifiedInstalledCommunityVersion('0.17.2.1', '0.17.2.2', { ...stamp, distributionVersion: '0.17.2.2' }, runtime),
+    '0.17.2.2'
+  )
