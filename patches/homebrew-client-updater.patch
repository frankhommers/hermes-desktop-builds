index 0000000000000000000000000000000000000000..d141e3e8dd2516420bda7baa6be3f63140b5b46a
--- /dev/null
+++ b/apps/desktop/electron/community-homebrew-update.test.ts
@@ -0,0 +1,276 @@
+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import {
+  COMMUNITY_CASK,
+  COMMUNITY_CASK_CONTENTS_API,
+  COMMUNITY_CHECK_FAILURE_TTL_MS,
+  COMMUNITY_CHECK_TTL_MS,
+  CommunityHomebrewChecker,
+  communityHomebrewConfig,
+  compareDottedVersions,
+  fetchCaskContents,
+  parseCaskContentsResponse,
+  pickHomebrewBinary,
+  readInstalledCommunityStamp,
+  runHomebrewUpdate,
+  verifiedInstalledCommunityVersion
+} from './community-homebrew-update'
+
+const stamp = {
+  distribution: 'desktop-app',
+  communityDistribution: 'frankhommers-homebrew',
+  distributionVersion: '0.17.2.1'
+}
+
+function caskPayload(source: string, overrides: Record<string, unknown> = {}) {
+  const raw = Buffer.from(source)
+
+  return { encoding: 'base64', type: 'file', size: raw.length, content: raw.toString('base64'), ...overrides }
+}
+
+test('only the packaged Frank Homebrew macOS distribution enables package updates', () => {
+  assert.deepEqual(communityHomebrewConfig(stamp, { isPackaged: true, platform: 'darwin' }), {
+    currentVersion: '0.17.2.1',
+    cask: COMMUNITY_CASK,
+    contentsApi: COMMUNITY_CASK_CONTENTS_API
+  })
+  assert.equal(communityHomebrewConfig(stamp, { isPackaged: false, platform: 'darwin' }), null)
+  assert.equal(communityHomebrewConfig(stamp, { isPackaged: true, platform: 'linux' }), null)
+  assert.equal(
+    communityHomebrewConfig(
+      { ...stamp, communityDistribution: 'somebody-else' },
+      { isPackaged: true, platform: 'darwin' }
+    ),
+    null
+  )
+  assert.equal(
+    communityHomebrewConfig(
+      { ...stamp, distributionVersion: '0.17.2.1; touch /tmp/pwn' },
+      { isPackaged: true, platform: 'darwin' }
+    ),
+    null
+  )
+})
+
+test('the tap payload yields only one strict version from the expected cask', () => {
+  const source = 'cask "hermes-desktop" do\n  version "0.17.2.3"\nend\n'
+  assert.equal(parseCaskContentsResponse(caskPayload(source)), '0.17.2.3')
+  assert.throws(() => parseCaskContentsResponse(caskPayload(source, { content: '@@@' })))
+  assert.throws(() => parseCaskContentsResponse(caskPayload(source, { encoding: 'utf8' })))
+  assert.throws(() => parseCaskContentsResponse(caskPayload(source, { size: Buffer.byteLength(source) - 1 })))
+  assert.throws(() => parseCaskContentsResponse(caskPayload('cask "somebody-else" do\n  version "0.17.2.3"\nend\n')))
+  assert.throws(() =>
+    parseCaskContentsResponse(
+      caskPayload('cask "hermes-desktop" do\n  version "0.17.2.3"\n  version "0.17.2.4"\nend\n')
+    )
+  )
+  assert.throws(() =>
+    parseCaskContentsResponse(caskPayload('cask "hermes-desktop" do\n  version "0.17.2.3; rm -rf /"\nend\n'))
+  )
+  assert.throws(() =>
+    parseCaskContentsResponse({
+      encoding: 'base64',
+      type: 'file',
+      size: 2,
+      content: Buffer.from([0xc3, 0x28]).toString('base64')
+    })
+  )
+})
+
+test('numeric dotted comparison is exact and rejects unsafe version shapes', () => {
+  assert.equal(compareDottedVersions('0.17.2', '0.17.2.1'), -1)
+  assert.equal(compareDottedVersions('0.17.2.10', '0.17.2.9'), 1)
+  assert.equal(compareDottedVersions('0.17.2.1', '0.17.2.1'), 0)
+  assert.throws(() => compareDottedVersions('0.17.9007199254740992', '0.17.9007199254740993'))
+  assert.throws(() => compareDottedVersions('0.17.2.1.1', '0.17.2.1'))
+})
+
+test('post-install proof requires the running community bundle to reach the checked target', () => {
+  const runtime = { isPackaged: true, platform: 'darwin' }
+  assert.equal(
+    verifiedInstalledCommunityVersion('0.17.2.1', '0.17.2.2', { ...stamp, distributionVersion: '0.17.2.2' }, runtime),
+    '0.17.2.2'
+  )
+  assert.equal(
+    verifiedInstalledCommunityVersion('0.17.2.1', '0.17.2.2', { ...stamp, distributionVersion: '0.17.2.3' }, runtime),
+    '0.17.2.3'
+  )
+  assert.throws(() => verifiedInstalledCommunityVersion('0.17.2.1', '0.17.2.2', stamp, runtime))
+  assert.throws(() =>
+    verifiedInstalledCommunityVersion('0.17.2.1', '0.17.2.3', { ...stamp, distributionVersion: '0.17.2.2' }, runtime)
+  )
+  assert.throws(() =>
+    verifiedInstalledCommunityVersion(
+      '0.17.2.1',
+      '0.17.2.2',
+      { ...stamp, communityDistribution: 'somebody-else', distributionVersion: '0.17.2.2' },
+      runtime
+    )
+  )
+})
+
+test('brew resolution accepts only an executable from the fixed macOS locations', () => {
+  assert.equal(
+    pickHomebrewBinary(path => path === '/opt/homebrew/bin/brew'),
+    '/opt/homebrew/bin/brew'
+  )
+  assert.equal(
+    pickHomebrewBinary(path => path === '/usr/local/bin/brew'),
+    '/usr/local/bin/brew'
+  )
+  assert.equal(
+    pickHomebrewBinary(() => false),
+    null
+  )
+})
+
+test('package update executes fixed argv in order and stops on failure', async () => {
+  const calls: { command: string; args: string[] }[] = []
+  await runHomebrewUpdate('/opt/homebrew/bin/brew', async (command, args) => {
+    calls.push({ command, args })
+
+    return { code: 0, output: 'ok' }
+  })
+  assert.deepEqual(calls, [
+    { command: '/opt/homebrew/bin/brew', args: ['update'] },
+    { command: '/opt/homebrew/bin/brew', args: ['upgrade', '--cask', COMMUNITY_CASK] }
+  ])
+
+  await assert.rejects(
+    () =>
+      runHomebrewUpdate('/opt/homebrew/bin/brew', async (_command, args) => ({
+        code: args[0] === 'update' ? 1 : 0,
+        output: 'network failed'
+      })),
+    /Homebrew update failed.*network failed/
+  )
+})
+
+test('upstream desktop-app stamps without the community identity never enable Homebrew updates', () => {
+  const official = { distribution: 'desktop-app', distributionVersion: '0.17.2.1' }
+  assert.equal(communityHomebrewConfig(official, { isPackaged: true, platform: 'darwin' }), null)
+  assert.equal(
+    communityHomebrewConfig(
+      { distribution: 'frankhommers-homebrew', distributionVersion: '0.17.2.1' },
+      {
+        isPackaged: true,
+        platform: 'darwin'
+      }
+    ),
+    null
+  )
+})
+
+test('tap checks are keyed on the Desktop version and honour success/failure TTLs', async () => {
+  let now = 1_000_000
+
+  const responses: unknown[] = [
+    caskPayload('cask "hermes-desktop" do\n  version "0.17.2.2"\nend\n'),
+    new Error('offline'),
+    caskPayload('cask "hermes-desktop" do\n  version "0.17.2.1"\nend\n')
+  ]
+
+  const urls: string[] = []
+
+  const checker = new CommunityHomebrewChecker(
+    async url => {
+      urls.push(url)
+      const next = responses.shift()
+
+      if (next instanceof Error) {
+        throw next
+      }
+
+      return next
+    },
+    () => now
+  )
+
+  const config = communityHomebrewConfig(stamp, { isPackaged: true, platform: 'darwin' })!
+
+  const first = await checker.check(config, '/Applications/Hermes.app')
+  assert.equal(first.updateAvailable, true)
+  assert.equal(first.targetVersion, '0.17.2.2')
+  assert.equal(first.targetSha, 'homebrew:0.17.2.2')
+  assert.equal(first.currentSha, 'homebrew:0.17.2.1')
+  assert.deepEqual(urls, [COMMUNITY_CASK_CONTENTS_API])
+
+  now += COMMUNITY_CHECK_TTL_MS - 1
+  assert.equal(await checker.check(config, '/Applications/Hermes.app'), first)
+  const failed = await checker.check(config, '/Applications/Hermes.app', { force: true })
+  assert.equal(failed.error, 'fetch-failed')
+  assert.match(failed.message ?? '', /offline/)
+  assert.equal(failed.updateAvailable, undefined)
+
+  now += COMMUNITY_CHECK_FAILURE_TTL_MS - 1
+  assert.equal(await checker.check(config, '/Applications/Hermes.app'), failed)
+  now += 1
+  const current = await checker.check(config, '/Applications/Hermes.app')
+  assert.equal(current.updateAvailable, false)
+  assert.equal(current.behind, 0)
+  assert.equal(urls.length, 3)
+})
+
+test('the tap fetcher refuses any URL but the fixed contents endpoint', async () => {
+  let called = false
+
+  const get = ((..._args: unknown[]) => {
+    called = true
+    throw new Error('unexpected')
+  }) as never
+
+  await assert.rejects(
+    () => fetchCaskContents('https://api.github.com/repos/x/y/contents/z', get),
+    /unexpected Homebrew tap URL/
+  )
+  assert.equal(called, false)
+})
+
+test('the on-disk sidecar is read only from the running resources path and must be a bounded object', () => {
+  const seen: string[] = []
+
+  const reader = (body: string | Buffer) =>
+    ((file: string) => {
+      seen.push(file)
+
+      return Buffer.isBuffer(body) ? body : Buffer.from(body)
+    }) as never
+
+  const installed = { ...stamp, distributionVersion: '0.17.2.2' }
+  assert.deepEqual(readInstalledCommunityStamp('/App/Contents/Resources', reader(JSON.stringify(installed))), installed)
+  // Exactly one read: the sidecar directly inside the running resources path, in the
+  // host's own path spelling (path.join normalises to backslashes on Windows).
+  const sidecar =
+    process.platform === 'win32'
+      ? '\\App\\Contents\\Resources\\install-stamp.json'
+      : '/App/Contents/Resources/install-stamp.json'
+  assert.deepEqual(seen, [sidecar])
+  assert.equal(readInstalledCommunityStamp('/r', reader('[1]')), null)
+  assert.equal(readInstalledCommunityStamp('/r', reader('null')), null)
+  assert.equal(readInstalledCommunityStamp('/r', reader('{')), null)
+  assert.equal(readInstalledCommunityStamp('/r', reader(Buffer.alloc(64 * 1024 + 1, 32))), null)
+  assert.equal(
+    readInstalledCommunityStamp('/r', (() => {
+      throw new Error('ENOENT')
+    }) as never),
+    null
+  )
+})
+
+test('Homebrew failure output is colour-stripped and bounded', async () => {
+  await assert.rejects(
+    () =>
+      runHomebrewUpdate('/opt/homebrew/bin/brew', async () => ({
+        code: 1,
+        output: `\u001b[31mError:\u001b[0m ${'x'.repeat(3_000)}`
+      })),
+    (error: Error) => {
+      assert.equal(error.message.includes(String.fromCharCode(27)), false)
+      assert.ok(error.message.length < 2_100)
+
+      return true
+    }
+  )
+})
