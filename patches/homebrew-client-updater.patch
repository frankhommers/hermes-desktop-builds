index 076d5a893e2346ad07f260ef5790b0fb0d9e5831..8d5c79b511c2c5388ef9e1c3e91ae6043902ab20 100644
--- a/apps/desktop/scripts/write-build-stamp.mjs
+++ b/apps/desktop/scripts/write-build-stamp.mjs
@@ -97,6 +97,24 @@ export function fromFallback(branch = FALLBACK_BRANCH) {
   }
 }
 
+const COMMUNITY_DISTRIBUTION = "frankhommers-homebrew"
+const DISTRIBUTION_VERSION_PATTERN = /^(?:0|[1-9]\d*)(?:\.(?:0|[1-9]\d*)){2,4}$/
+
+export function resolveDistribution(env = process.env) {
+  const identity = env.HERMES_DESKTOP_DISTRIBUTION
+  const version = env.HERMES_DESKTOP_DISTRIBUTION_VERSION
+
+  if (!identity && !version) return {}
+  if (identity !== COMMUNITY_DISTRIBUTION) {
+    throw new Error("Unsupported desktop distribution identity")
+  }
+  if (typeof version !== "string" || !DISTRIBUTION_VERSION_PATTERN.test(version)) {
+    throw new Error("Invalid desktop distribution version")
+  }
+
+  return { distribution: identity, distributionVersion: version }
+}
+
 /**
  * Resolve the install stamp without writing it.  Pure enough for unit tests:
  * inject env / execFn / repoRoot to simulate CI, local git, or no-git trees.
@@ -155,7 +173,8 @@ function main() {
     branch: stamp.branch,
     builtAt: new Date().toISOString(),
     dirty: stamp.dirty,
-    source: stamp.source
+    source: stamp.source,
+    ...resolveDistribution(process.env)
   }
 
   mkdirSync(OUT_DIR, { recursive: true })
