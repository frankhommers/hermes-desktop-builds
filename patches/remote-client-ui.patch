--- /dev/null
+++ b/apps/desktop/src/app/chat/sidebar/fleet-rail-community.test.ts
@@ -0,0 +1,47 @@
+import { describe, expect, it } from 'vitest'
+
+import type { DesktopAgentRoster, DesktopRegistryConnection } from '@/global'
+
+import { buildRestGroups } from './fleet-rail'
+
+const connections = [
+  { id: 'local', kind: 'local', label: 'This device' },
+  { id: 'remote', kind: 'remote', label: 'Server' },
+  { id: 'ssh', kind: 'ssh', label: 'SSH' }
+] as DesktopRegistryConnection[]
+
+function roster(error = 'connect-on-demand', localProfiles: string[] = []): DesktopAgentRoster {
+  return {
+    agents: localProfiles.map(profile => ({ connectionId: 'local', connectionKind: 'local',
+      connectionLabel: 'This device', profile, handle: profile })),
+    sources: connections.map(connection => ({ connectionId: connection.id, kind: connection.kind,
+      label: connection.label, reachable: false, error }))
+  }
+}
+
+describe('community fleet presentation', () => {
+  it.each(['remote', 'ssh'])('omits only an empty deferred local group while %s is active', activeConnectionId => {
+    const input = { activeConnectionId, connections, roster: roster() }
+    const before = structuredClone(input)
+    const groups = buildRestGroups(input)
+    expect(groups.map(group => group.connectionId)).toEqual(
+      connections.filter(connection => !['local', activeConnectionId].includes(connection.id)).map(connection => connection.id)
+    )
+    expect(input).toEqual(before)
+  })
+
+  it.each([
+    { activeConnectionId: 'remote', roster: roster('permission denied') },
+    { activeConnectionId: 'remote', roster: roster('connect-on-demand', ['default', 'work']) },
+    { activeConnectionId: null, roster: roster() },
+    { activeConnectionId: 'unknown', roster: roster() },
+    { activeConnectionId: 'remote', roster: null }
+  ])('preserves local data, real failures and unresolved active sources: %j', input => {
+    const groups = buildRestGroups({ connections, ...input })
+    const local = groups.find(group => group.connectionId === 'local')
+    expect(local).toBeDefined()
+    expect(local?.named.map(agent => agent.profile)).toEqual(
+      input.roster?.agents.filter(agent => agent.profile !== 'default').map(agent => agent.profile) ?? []
+    )
+  })
+})
